# Copy this file to .env.local and fill in the values. Never commit .env.local.

# WordPress site address (no trailing slash).
# Leave EMPTY to use the bundled snapshot in data/wordpress.json (no WordPress needed).
# LocalWP example: http://spoonful.local
WORDPRESS_URL=

# Public URL of the Next.js site, used for canonical URLs, Open Graph and the sitemap.
# On Vercel you can leave it empty: the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate/ (WordPress calls it when content changes).
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Contact form email via https://resend.com (optional).
# If RESEND_API_KEY is empty, messages are printed in the server log instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Spoonful <onboarding@resend.dev>"
